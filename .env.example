# Same Atlas anonymous public RPC credentials (publishable key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public Atlas origin for profile deep-links from search results.
NEXT_PUBLIC_ATLAS_ORIGIN=https://atlas.matchmed.app

# Same PostHog project as Atlas (production only). Publishable project token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
